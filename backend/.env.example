DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=unsafe-local-development-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL is omitted locally so Django uses backend/db.sqlite3.
DATABASE_CONN_MAX_AGE=0
PUBLIC_CONTACT_PHONE=0720 084 756
FRONTEND_URL=http://localhost:5173
INVITATION_EXPIRY_HOURS=48
DEFAULT_FROM_EMAIL=noreply@utilityinlife.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
AUTH_THROTTLE_RATE=10/min
INVITATION_ACCEPT_THROTTLE_RATE=20/hour
PUBLIC_ENROLLMENT_THROTTLE_RATE=20/hour
PAYMENT_DEFAULT_DUE_DAYS=7
# Keep mock mode by default. Switch to payhero only when the backend callback URL is public over HTTPS.
PAYMENT_GATEWAY=mock
# Local callback authentication only. Replace with a long random value outside development.
MPESA_CALLBACK_TOKEN=unsafe-local-mpesa-callback-token
# PayHero Kenya STK Push. Store credentials only in backend/.env or the deployment secret store.
PAYHERO_API_BASE_URL=https://backend.payhero.co.ke
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
# PayHero channel ID supplied for this account.
PAYHERO_CHANNEL_ID=
# Public URL prefix, e.g. https://api.example.com/api/v1/payments/mpesa/payhero
PAYHERO_CALLBACK_BASE_URL=
PAYHERO_REQUEST_TIMEOUT=15
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIME_ZONE=Africa/Nairobi
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
LOG_LEVEL=INFO
